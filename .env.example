# Umgebungsvariablen für Easypanel (App → Environment)

# Passwort für /admin.php (leer = Admin-Bereich deaktiviert)
ADMIN_PASSWORD=

# Bis wann (Europe/Berlin) Reservierungen angelegt/geändert werden können
DEADLINE=2026-11-08 23:59:59
# Höchstzahl Plätze pro Reservierung (mindestens sind es immer 2)
MAX_SEATS=20
EVENT_NAME=STAFERO-Jubiläumsball
# Angaben zur Veranstaltung (Seite + Bestätigungsmail)
EVENT_DATE=Sa, 21. November 2026
EVENT_DOORS=18:30 Uhr
EVENT_START=19:30 Uhr
TICKET_URL=https://ball.stafero.de
CONTACT_EMAIL=reservierung@stafero.de
DB_PATH=/data/reservierungen.sqlite

# Öffentliche Adresse der Seite (für den Link in den Mails)
APP_URL=https://reservierung.stafero.de

# Bestätigungsmails per SMTP (leer = kein Mailversand, E-Mail-Feld wird dann ausgeblendet)
SMTP_HOST=
SMTP_PORT=587
# tls = STARTTLS (Port 587), ssl = SMTPS (Port 465), none = unverschlüsselt
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM=reservierung@stafero.de
MAIL_FROM_NAME=STAFERO e.V.
# Optional: Kopie jeder Bestätigung an diese Adresse
MAIL_BCC=
